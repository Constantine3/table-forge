{
  "name": "@deepseek-ai/dsh-game-app",
  "description": "Table Forge game product bundle over the browser runtime",
  "version": "0.1.0-rc.5",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/bundle/game-app" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "cordis.patch.yml", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-game": "workspace:^",
    "@deepseek-ai/dsh-client-ui-game-avalon": "workspace:^",
    "@deepseek-ai/dsh-client-ui-game-rps": "workspace:^",
    "@deepseek-ai/dsh-game": "workspace:^",
    "@deepseek-ai/dsh-game-controller-agent": "workspace:^",
    "@deepseek-ai/dsh-game-engine": "workspace:^",
    "@deepseek-ai/dsh-game-avalon": "workspace:^",
    "@deepseek-ai/dsh-game-persistence-sqlite": "workspace:^",
    "@deepseek-ai/dsh-game-rps": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker-browse": "workspace:^"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:^", "@deepseek-ai/dsh-invariants": "workspace:^" },
  "devDependencies": { "@deepseek-ai/cordis": "workspace:^", "@deepseek-ai/dsh-invariants": "workspace:^" }
}
